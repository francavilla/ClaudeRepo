<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Logica dell'applicazione, senza dipendenze dalla UI né dalla console:
    inventario di solution e progetti, rilevamento degli "smell" WinForms, priorità e report.
    Target netstandard2.0: riusabile dalla CLI (.NET 8) e, in futuro, dalla UI WPF (.NET Framework 4.8).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>SolutionDoctor.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SolutionDoctor.Core.Tests" />
  </ItemGroup>

</Project>
