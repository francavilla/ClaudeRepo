<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Logica dell'applicazione, senza dipendenze dalla UI:
    generatori di password, policy, controllo di somiglianza, promemoria e impostazioni.
  -->
  <PropertyGroup>
    <!-- net48 per l'app Windows e i test, netstandard2.0 per l'app Android. -->
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>PasswordGen.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lista delle parole italiane per le passphrase, incorporata nell'eseguibile. -->
    <EmbeddedResource Include="Words\it.txt" />
    <InternalsVisibleTo Include="PasswordGen.Core.Tests" />
  </ItemGroup>

</Project>
