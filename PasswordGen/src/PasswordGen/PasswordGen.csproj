<Project Sdk="Microsoft.NET.Sdk">

  <!-- Applicazione desktop WPF per .NET Framework 4.8 (formato SDK-style, Visual Studio 2019 16.3+). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PasswordGen</AssemblyName>
    <RootNamespace>PasswordGen</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icona del file .exe. Si rigenera con tools/make_icon.py. -->
    <ApplicationIcon>Assets\PasswordGen.ico</ApplicationIcon>
    <AssemblyTitle>PasswordGen - password casuali, sicure e facili da ricordare</AssemblyTitle>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Client OAuth «App desktop» di Google Cloud per l'accesso a Google Drive. L'ID client è pubblico; la chiave del client (per le app per computer
      non è considerata riservata) non sta nel repository: la CI la passa con -p:GoogleDesktopClientSecret=<secret GOOGLE_DESKTOP_CLIENT_SECRET>.
      Se uno dei due manca, l'opzione Google Drive risulta non configurata (resta la sincronizzazione con un file).
    -->
    <GoogleDesktopClientId Condition="'$(GoogleDesktopClientId)' == ''"></GoogleDesktopClientId>
    <GoogleDesktopClientSecret Condition="'$(GoogleDesktopClientSecret)' == ''"></GoogleDesktopClientSecret>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GoogleClientId</_Parameter1>
      <_Parameter2>$(GoogleDesktopClientId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GoogleClientSecret</_Parameter1>
      <_Parameter2>$(GoogleDesktopClientSecret)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Icona della finestra (barra del titolo, barra delle applicazioni, Alt+Tab). -->
    <Resource Include="Assets\PasswordGen.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Proiezione delle API di Windows 10 (Windows Hello: UserConsentVerifier) per .NET Framework. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- HttpClient per l'accesso a Google Drive. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PasswordGen.Core\PasswordGen.Core.csproj" />
  </ItemGroup>

</Project>
