<!-- Palette scura di PasswordGen: stessi nomi della palette scura, scelta all'avvio da ThemeManager. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A5F" />

    <SolidColorBrush x:Key="WindowBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="CardBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="InputBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#182234" />
    <SolidColorBrush x:Key="HoverBrush" Color="#273449" />
    <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#3B1D22" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A2F12" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#78591B" />
    <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#172A4D" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#12301F" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#166534" />

    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#111C3F" Offset="0" />
        <GradientStop Color="#1E40AF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
