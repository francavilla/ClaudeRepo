<!-- Palette chiara di PasswordGen: stessi nomi della palette scura, scelta all'avvio da ThemeManager. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DBEAFE" />

    <SolidColorBrush x:Key="WindowBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FECACA" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FDE68A" />
    <SolidColorBrush x:Key="InfoBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#BFDBFE" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#F0FDF4" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#86EFAC" />

    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E3A8A" Offset="0" />
        <GradientStop Color="#2563EB" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
