<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PasswordGen.Mobile.ViewModels"
             x:Class="PasswordGen.Mobile.HistoryPage"
             x:DataType="vm:MainViewModel"
             Title="{Binding HistoryHeader}"
             BackgroundColor="{DynamicResource PageBg}">

    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" BackgroundColor="{DynamicResource Header}" Padding="18,14" Spacing="2">
            <Label Text="Storico delle password" TextColor="White" FontSize="22" FontAttributes="Bold" />
            <Label Text="Le ultime 20 password che hai usato, cifrate con una chiave del Keystore di Android."
                   TextColor="#CCFFFFFF" FontSize="12" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Regola delle ultime 20 password" FontAttributes="Bold" />
                        <Label Style="{StaticResource MutedText}"
                               Text="Con «Ho cambiato la password» scegli quale proposta hai usato e viene salvata qui (ultime 20). La nuova password non può essere identica a una di quelle e le proposte evitano anche le loro varianti. Lo storico è sempre attivo e le singole voci non si possono eliminare." />
                        <Button Text="Azzera storico..." Command="{Binding ClearHistoryCommand}"
                                BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource Danger}" BorderColor="{DynamicResource DangerBorder}" BorderWidth="1" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding HistoryUsageText}" Style="{StaticResource MutedText}" />
                    <ProgressBar Progress="{Binding HistoryUsage}" ProgressColor="{DynamicResource Accent}" />
                </VerticalStackLayout>

                <Label Style="{StaticResource MutedText}" FontAttributes="Italic" IsVisible="{Binding HasHistory, Converter={StaticResource InvertedBool}}"
                       Text="Lo storico è ancora vuoto: dopo aver cambiato la password premi «Ho cambiato la password» nella scheda Genera." />

                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding HistoryEntries}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryEntryItem">
                            <Grid ColumnDefinitions="26,*" Margin="0,0,0,8">
                                <!-- Linea del tempo -->
                                <BoxView WidthRequest="2" Color="{DynamicResource Border}" HorizontalOptions="Center" Margin="0,22,0,-8" />
                                <Border WidthRequest="12" HeightRequest="12" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,16,0,0"
                                        BackgroundColor="{DynamicResource Accent}" Stroke="Transparent" IsVisible="{Binding IsCurrent}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                </Border>
                                <Border WidthRequest="12" HeightRequest="12" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,16,0,0"
                                        BackgroundColor="{DynamicResource BorderStrong}" Stroke="Transparent" IsVisible="{Binding IsNotCurrent}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Border BackgroundColor="{DynamicResource AccentSoft}" Stroke="Transparent" Padding="8,1" VerticalOptions="Center"
                                                    IsVisible="{Binding IsCurrent}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>
                                                <Label Text="In uso" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource Accent}" />
                                            </Border>
                                            <Label Text="{Binding DateText}" Style="{StaticResource MutedText}" VerticalOptions="Center" />
                                            <Label Text="{Binding ModeText}" Style="{StaticResource MutedText}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding DisplayText}" FontFamily="monospace" FontSize="17" FontAttributes="Bold"
                                               LineBreakMode="CharacterWrap" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <Button Grid.Column="0" Text="{Binding ToggleText}" Command="{Binding ToggleCommand}"
                                                    BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource Accent}" BorderColor="{DynamicResource BorderStrong}" BorderWidth="1" />
                                            <Button Grid.Column="1" Text="Copia" Command="{Binding CopyCommand}"
                                                    BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource Accent}" BorderColor="{DynamicResource BorderStrong}" BorderWidth="1" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" Background="{DynamicResource CardBg}" Stroke="{DynamicResource Border}" StrokeThickness="1" Padding="14,8">
            <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" LineBreakMode="TailTruncation" />
        </Border>
    </Grid>
</ContentPage>
