<Project Sdk="Microsoft.NET.Sdk">

  <!--
    App Android (.NET MAUI) di PasswordGen. Riusa PasswordGen.Core (netstandard2.0).
    Il nome dell'assembly non usa "Android" nel namespace per non confondersi con i namespace Android.* della piattaforma.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>PasswordGen.Mobile</RootNamespace>
    <AssemblyName>PasswordGen.Mobile</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Il repository usa C# 7.3 (Directory.Build.props); MAUI richiede un linguaggio moderno. -->
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>PasswordGen</ApplicationTitle>
    <ApplicationId>net.francavilla.passwordgen</ApplicationId>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- Numero intero crescente richiesto da Android: la CI lo imposta con -p:ApplicationVersion=<numero del run>. -->
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Niente trimming: le associazioni XAML e la serializzazione JSON del Core usano la reflection. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- L'AOT in Release richiede il trimming: si usa il normale JIT (APK più grande ma senza sorprese). -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <!-- APK più piccola: in Release solo le architetture dei telefoni reali (64 e 32 bit ARM), senza x86/x64 degli emulatori. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1E3A8A" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PasswordGen.Core\PasswordGen.Core.csproj" />
  </ItemGroup>

</Project>
