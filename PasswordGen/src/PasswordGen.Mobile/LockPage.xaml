<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasswordGen.Mobile.LockPage"
             BackgroundColor="{DynamicResource Header}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center" Spacing="14" Padding="32">
            <Label Text="🔒" FontSize="64" HorizontalOptions="Center" />
            <Label x:Name="TitleLabel" Text="PasswordGen è bloccata" TextColor="White" FontSize="22" FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label x:Name="HintLabel" TextColor="#CCFFFFFF" HorizontalTextAlignment="Center" />

            <Entry x:Name="SecretEntry" IsPassword="True" TextColor="White" PlaceholderColor="#99FFFFFF"
                   HorizontalTextAlignment="Center" Completed="OnSecretClicked" IsVisible="False" />
            <Button x:Name="SecretButton" Text="Sblocca" Clicked="OnSecretClicked" BackgroundColor="{DynamicResource CardBg}"
                    TextColor="{DynamicResource Header}" FontAttributes="Bold" CornerRadius="10" IsVisible="False" />

            <Label x:Name="MessageLabel" TextColor="#FCA5A5" FontSize="13" HorizontalTextAlignment="Center" IsVisible="False" />

            <Button x:Name="BiometricButton" Text="Sblocca con impronta" Clicked="OnBiometricClicked" BackgroundColor="Transparent"
                    TextColor="White" BorderColor="#99FFFFFF" BorderWidth="1" CornerRadius="10" IsVisible="False" />
            <Button x:Name="PhonePinButton" Text="Usa il PIN del telefono" Clicked="OnPhonePinClicked" BackgroundColor="Transparent"
                    TextColor="White" BorderColor="#99FFFFFF" BorderWidth="1" CornerRadius="10" IsVisible="False" />
            <Button x:Name="CancelButton" Text="Annulla" Clicked="OnCancelClicked" BackgroundColor="Transparent"
                    TextColor="#CCFFFFFF" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
