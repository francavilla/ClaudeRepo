<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:PasswordGen.Mobile.Services"
             x:Class="PasswordGen.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <svc:InvertedBoolConverter x:Key="InvertedBool" />
            <!-- Palette chiara di partenza: App.xaml.cs la sostituisce con quella scura quando il telefono usa il tema scuro. -->
            <Color x:Key="Accent">#2563EB</Color>
            <Color x:Key="Header">#1E3A8A</Color>
            <Color x:Key="Muted">#64748B</Color>
            <Color x:Key="PageBg">#F1F5F9</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#0F172A</Color>
            <Color x:Key="Border">#E2E8F0</Color>
            <Color x:Key="BorderStrong">#CBD5E1</Color>
            <Color x:Key="Danger">#DC2626</Color>
            <Color x:Key="DangerBorder">#FECACA</Color>
            <Color x:Key="WarnBg">#FEF3C7</Color>
            <Color x:Key="WarnSoft">#FFFBEB</Color>
            <Color x:Key="WarnBorder">#FDE68A</Color>
            <Color x:Key="WarnText">#B45309</Color>

            <!-- Testi e campi: colori espliciti, altrimenti Android li sceglie col suo tema. -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource Muted}" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="TitleColor" Value="{DynamicResource Muted}" />
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBg}" />
                <Setter Property="Stroke" Value="{DynamicResource Border}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="12" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardTitle" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
            </Style>

            <Style x:Key="MutedText" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{DynamicResource Muted}" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
