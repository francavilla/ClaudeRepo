<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PasswordGen.Mobile.ViewModels"
             x:Class="PasswordGen.Mobile.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Genera"
             BackgroundColor="{DynamicResource PageBg}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Intestazione -->
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{DynamicResource Header}" Padding="18,14" Spacing="2">
            <Label Text="{Binding Title}" TextColor="White" FontSize="22" FontAttributes="Bold" />
            <Label Text="Password casuali, sicure e facili da ricordare. Tutto resta sul telefono."
                   TextColor="#CCFFFFFF" FontSize="12" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">

                <!-- Suggerimento: attiva il blocco -->
                <Border BackgroundColor="{DynamicResource WarnBg}" Stroke="{DynamicResource WarnBorder}" StrokeThickness="1" Padding="14" IsVisible="{Binding ShowLockHint}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Proteggi PasswordGen con impronta, volto o PIN: chi prende il telefono non potrà vedere lo storico delle password."
                               TextColor="{DynamicResource TextPrimary}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Attiva il blocco" Command="{Binding EnableLockFromHintCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Grid.Column="1" Text="Non ora" Command="{Binding DismissLockHintCommand}"
                                    BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource Accent}" BorderColor="{DynamicResource BorderStrong}" BorderWidth="1" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Promemoria: giorni alla scadenza e avanzamento -->
                <Border BackgroundColor="{Binding ReminderBackground}" Stroke="{DynamicResource Border}" StrokeThickness="1" Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <VerticalStackLayout IsVisible="{Binding HasReminderDays}" VerticalOptions="Center" WidthRequest="78">
                                <Label Text="{Binding ReminderDaysText}" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding ReminderDaysCaption}" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding ReminderMessage}" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding LastChangeText}" Style="{StaticResource MutedText}" />
                                <ProgressBar Progress="{Binding ReminderProgress}" ProgressColor="{Binding ReminderProgressColor}"
                                             IsVisible="{Binding HasReminderDays}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Button Text="Ho cambiato la password" Command="{Binding MarkChangedCommand}"
                                BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource Accent}" BorderColor="{DynamicResource BorderStrong}" BorderWidth="1" />
                    </VerticalStackLayout>
                </Border>

                <!-- Proposte -->
                <Button Text="Genera nuove proposte" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateCommand}" />

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Suggestions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SuggestionItem">
                            <Grid>
                                <!-- Prima proposta: in primo piano -->
                                <Border Style="{StaticResource Card}" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" Padding="16"
                                        IsVisible="{Binding IsPrimary}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="10">
                                        <Label Text="{Binding Text}" FontFamily="monospace" FontSize="22" FontAttributes="Bold"
                                               LineBreakMode="CharacterWrap" />
                                        <ProgressBar Progress="{Binding StrengthFraction}" ProgressColor="{Binding LevelColor}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Label Text="{Binding LevelText}" TextColor="{Binding LevelColor}" FontAttributes="Bold" FontSize="13" />
                                                <Label Text="{Binding BitsText}" Style="{StaticResource MutedText}" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Button Grid.Column="1" Text="Copia" Command="{Binding CopyCommand}" Style="{StaticResource PrimaryButton}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                                <!-- Altre proposte: compatte -->
                                <Border Style="{StaticResource Card}" IsVisible="{Binding IsSecondary}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Text}" FontFamily="monospace" FontSize="16" FontAttributes="Bold"
                                                   LineBreakMode="CharacterWrap" />
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding LevelText}" TextColor="{Binding LevelColor}" FontAttributes="Bold" FontSize="12" />
                                                <Label Text="{Binding BitsText}" Style="{StaticResource MutedText}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Copia" Command="{Binding CopyCommand}" VerticalOptions="Center"
                                                BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource Accent}" BorderColor="{DynamicResource BorderStrong}" BorderWidth="1" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Tipo di password -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Tipo di password" Style="{StaticResource CardTitle}" />
                        <Label Text="Scegli come generare le password. Lunghezze e regole sono in «Impostazioni»." Style="{StaticResource MutedText}" />

                        <Border BackgroundColor="{DynamicResource PageBg}" Stroke="{DynamicResource Border}" StrokeThickness="1" Padding="3">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
                            <Border Grid.Column="0" Padding="6,10" BackgroundColor="{Binding PassphraseBackground}" Stroke="Transparent">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectModeCommand}" CommandParameter="0" />
                                </Border.GestureRecognizers>
                                <Label Text="Parole" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource TextPrimary}" />
                            </Border>
                            <Border Grid.Column="1" Padding="6,10" BackgroundColor="{Binding SyllablesBackground}" Stroke="Transparent">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectModeCommand}" CommandParameter="1" />
                                </Border.GestureRecognizers>
                                <Label Text="Sillabe" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource TextPrimary}" />
                            </Border>
                            <Border Grid.Column="2" Padding="6,10" BackgroundColor="{Binding RandomBackground}" Stroke="Transparent">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectModeCommand}" CommandParameter="2" />
                                </Border.GestureRecognizers>
                                <Label Text="Caratteri" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource TextPrimary}" />
                            </Border>
                            </Grid>
                        </Border>
                        <Label Text="{Binding ModeDescription}" TextColor="{DynamicResource TextPrimary}" />
                        <Label Text="{Binding ModeExample}" FontFamily="monospace" Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Password attuale -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password attuale (facoltativa)" Style="{StaticResource CardTitle}" />
                        <Entry x:Name="PreviousEntry" IsPassword="True" Placeholder="Password attuale"
                               Text="{Binding PreviousPassword, Mode=TwoWay}" />
                        <Label Style="{StaticResource MutedText}"
                               Text="Se la indichi, le nuove proposte saranno sensibilmente diverse. Resta solo in memoria: non viene mai salvata." />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Stato -->
        <Border Grid.Row="2" Background="{DynamicResource CardBg}" Stroke="{DynamicResource Border}" StrokeThickness="1" Padding="14,8">
            <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" LineBreakMode="TailTruncation" />
        </Border>
    </Grid>
</ContentPage>
