<Project>
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Company>PasswordGen</Company>
    <Product>PasswordGen</Product>
    <Version>2.8.2</Version>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Permette la build anche dove il Developer Pack .NET Framework non è installato (CI, container). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
