<Project>
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Company>DesktopAppTemplate</Company>
    <Product>DesktopAppTemplate</Product>
    <Version>4.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Permette la build anche dove il Developer Pack .NET Framework non è installato (CI, container). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
