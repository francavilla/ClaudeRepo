<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Interfaccia predefinita: "wpf" oppure "winforms". L'argomento della riga di comando "ui" ha la precedenza (vedi README). -->
    <add key="Ui" value="wpf" />
    <!-- Cartella dei dati (file tasks.json). Vuota = %LocalAppData%\DesktopAppTemplate. Sono ammesse variabili come %USERPROFILE%. -->
    <add key="DataFolder" value="" />
  </appSettings>
</configuration>
