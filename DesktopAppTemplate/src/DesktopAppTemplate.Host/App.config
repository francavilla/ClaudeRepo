<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Parametri dell'applicazione. La riga di comando prevale su questi valori (l'opzione di aiuto della riga di comando ne elenca tutti i parametri). -->
    <!-- Ui: interfaccia da avviare, "wpf" oppure "winforms". -->
    <add key="Ui" value="wpf" />
    <!-- Storage: database in cui salvare i dati, "sqlite" (predefinito) oppure "sqlserver". -->
    <add key="Storage" value="sqlite" />
    <!-- DataAccess: accesso al database, "ado" (predefinito) oppure "dal" (libreria DAL). -->
    <add key="DataAccess" value="ado" />
    <!-- ConnectionString: stringa di connessione. Obbligatoria con sqlserver (meglio con Integrated Security=True, senza password). Vuota con sqlite = file nella cartella dei dati. -->
    <add key="ConnectionString" value="" />
    <!-- LogTargets: dove scrivere il log, "file" (predefinito), "db", "file,db" oppure "none". -->
    <add key="LogTargets" value="file" />
    <!-- LogLevel: livello minimo, trace, debug, information (predefinito), warning, error, critical oppure none. -->
    <add key="LogLevel" value="information" />
    <!-- LogFolder: cartella dei file di log. Vuota = sottocartella logs della cartella dei dati. -->
    <add key="LogFolder" value="" />
    <!-- LogRetentionDays: giorni di conservazione dei log (file e righe nel database). -->
    <add key="LogRetentionDays" value="30" />
    <!-- NoMigrate: true = non crea né aggiorna le tabelle all'avvio (lo schema deve già esistere, creato con gli script di Data/Scripts). -->
    <add key="NoMigrate" value="false" />
    <!-- DataFolder: cartella del database SQLite predefinito. Vuota = %LocalAppData%\DesktopAppTemplate. Ammesse variabili come %USERPROFILE%. -->
    <add key="DataFolder" value="" />
    <!-- ReadOnly: true = attività in sola lettura. -->
    <add key="ReadOnly" value="false" />
  </appSettings>
</configuration>
