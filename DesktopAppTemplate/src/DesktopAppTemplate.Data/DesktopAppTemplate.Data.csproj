<Project Sdk="Microsoft.NET.Sdk">

  <!-- Accesso al database con ADO.NET: connessioni (SQLite, SQL Server), dialetto SQL, executor, migrazioni dello schema, riga, SQL
       e repository delle attività. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>DesktopAppTemplate.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Script di creazione/aggiornamento dello schema, uno per database: Scripts\<Database>\V001_Nome.sql -->
    <EmbeddedResource Include="Scripts\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopAppTemplate.Core\DesktopAppTemplate.Core.csproj" />
    <ProjectReference Include="..\DesktopAppTemplate.Features\DesktopAppTemplate.Features.csproj" />
  </ItemGroup>

</Project>
