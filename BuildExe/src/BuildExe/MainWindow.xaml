<Window x:Class="BuildExe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BuildExe.ViewModels"
        xmlns:conv="clr-namespace:BuildExe.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="BuildExe" Width="1000" Height="820" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnFileDragOver"
        FontSize="13">
    <Window.Resources>
        <DataTemplate x:Key="ProjectItem">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DefaultTargetFramework.DisplayName, StringFormat='  —  {0}'}" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding FullPath, StringFormat='  ({0})'}" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="140" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
            </Grid.RowDefinitions>

            <!-- 1. Sorgente -->
            <GroupBox Grid.Row="0" Header="1. Progetto o solution">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Sfoglia..." Command="{Binding BrowseInputCommand}" />
                        <TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                 ToolTip="Percorso di un file .sln, .slnx, .csproj, .vbproj o .fsproj (anche trascinandolo sulla finestra)" />
                    </DockPanel>
                    <TextBlock Text="{Binding InputError}" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding IsSolution, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="Progetto eseguibile:" />
                        <ComboBox ItemsSource="{Binding SolutionProjects}" SelectedItem="{Binding SelectedProject}"
                                  ItemTemplate="{StaticResource ProjectItem}" IsEnabled="{Binding IsBusy, Converter={x:Static conv:InverseBooleanConverter.Instance}}" />
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <!-- 2. Analisi -->
            <GroupBox Grid.Row="1" Header="2. Analisi del progetto" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Progetto:" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}">
                        <Run Text="{Binding SelectedProject.Name, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{Binding SelectedProject.Language, Mode=OneWay, StringFormat=' ({0})'}" />
                    </TextBlock>

                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Formato:" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding SelectedProject.ProjectStyleDescription}" />

                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Tipo di output:" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding SelectedProject.OutputKind}" />

                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Target framework:" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <ComboBox MinWidth="260" ItemsSource="{Binding TargetFrameworks}" SelectedItem="{Binding SelectedTargetFramework}"
                                  IsEnabled="{Binding IsMultiTarget}" Margin="0,2">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Moniker, Mode=OneWay, StringFormat='  [{0}]'}" Foreground="{StaticResource MutedBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="progetto multi-target: scegliere il target"
                                   Visibility="{Binding IsMultiTarget, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Strumento di build:" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PlanDescription}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />

                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Sulla macchina:" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ToolchainSummary}" Foreground="{StaticResource MutedBrush}" />
                </Grid>
            </GroupBox>

            <!-- 3. Output -->
            <GroupBox Grid.Row="2" Header="3. Cartella di output (configurazione Release)">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Sfoglia..." Command="{Binding BrowseOutputCommand}" />
                        <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                 ToolTip="Percorso assoluto, oppure relativo alla cartella del progetto" />
                    </DockPanel>
                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding ResolvedOutputDirectory, StringFormat='→ {0}'}" />

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="{Binding IsNetCoreTarget}">
                        <CheckBox Content="Self-contained (include il runtime .NET)" IsChecked="{Binding SelfContained}" VerticalAlignment="Center" />
                        <CheckBox Content="File singolo" IsChecked="{Binding SingleFile}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Runtime:" Margin="16,0,6,0" VerticalAlignment="Center" />
                        <ComboBox IsEditable="True" Width="110" Text="{Binding RuntimeIdentifier, UpdateSourceTrigger=LostFocus}">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type sys:String}">
                                    <sys:String>win-x64</sys:String>
                                    <sys:String>win-x86</sys:String>
                                    <sys:String>win-arm64</sys:String>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="(solo .NET Core / .NET 5+)" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 4. Comando e messaggi -->
            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding PlanMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PlanMessage}">
                            <TextBlock TextWrapping="Wrap" Margin="0,1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        <Setter Property="Text" Value="{Binding Text, StringFormat='⚠ {0}'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                <Setter Property="Text" Value="{Binding Text, StringFormat='✖ {0}'}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox Margin="0,6,0,0" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Background="#F4F6F8"
                         Text="{Binding CommandPreview, Mode=OneWay}" ToolTip="Comando che verrà eseguito" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Crea eseguibile" Command="{Binding BuildCommand}" IsDefault="True" FontWeight="SemiBold" />
                    <Button Content="Annulla" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                    <Button Content="Apri cartella output" Command="{Binding OpenOutputCommand}" Margin="8,0,0,0" />
                    <Button Content="Aggiorna" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            ToolTip="Rileva di nuovo gli strumenti installati e rilegge il progetto" />
                    <Button Content="Copia log" Command="{Binding CopyLogCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- 5. Log -->
            <ListBox x:Name="LogList" Grid.Row="4" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LogLine}">
                        <TextBlock Text="{Binding Text}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LogKind.Error}">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LogKind.Warning}">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LogKind.Command}">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LogKind.Success}">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
