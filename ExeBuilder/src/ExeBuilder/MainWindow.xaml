<Window x:Class="ExeBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExeBuilder.ViewModels"
        xmlns:conv="clr-namespace:ExeBuilder.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{Binding WindowTitle}" Icon="Assets/ExeBuilder.ico" Width="1380" Height="1058" MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnFileDragOver">

    <DockPanel>
        <!-- ============================================================ Intestazione -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="24,12">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="12" Background="#33FFFFFF">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="22" Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="560" Margin="24,0,0,0">
                    <TextBlock Text="STRUMENTI SU QUESTA MACCHINA" FontSize="10" FontWeight="SemiBold" Foreground="#99FFFFFF" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ToolchainSummary}" FontSize="12" Foreground="#DDFFFFFF" TextWrapping="Wrap" TextAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ExeBuilder" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                        <Border Background="#33FFFFFF" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                ToolTip="Versione dell'applicazione">
                            <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Crea l'eseguibile Release di progetti e solution .NET e .NET Framework" Foreground="#CCFFFFFF" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Avanzamento durante la build -->
        <Grid DockPanel.Dock="Top" Height="3">
            <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- ============================================================ Barra di stato -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ============================================================ Contenuto -->
        <Grid x:Name="ContentGrid" Margin="20,14,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="180" />
            </Grid.RowDefinitions>

            <!-- Parte superiore: diventa scorrevole quando si allarga la console con il divisore -->
            <ScrollViewer x:Name="TopScroller" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>

                <!-- ======================================== Colonna sinistra -->
                <StackPanel Grid.Column="0">

                    <!-- 1. Progetto o solution -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Progetto o solution" />
                            </DockPanel>

                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding BrowseInputCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" />
                                        <TextBlock Text="Sfoglia..." Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBox Style="{StaticResource InputBox}"
                                         Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                         ToolTip="Percorso di un file .sln, .slnx, .csproj, .vbproj o .fsproj" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,0"
                                       Text="Trascina qui un file .sln, .slnx, .csproj, .vbproj o .fsproj, oppure usa Sfoglia." />

                            <!-- Errore di input -->
                            <Border CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                                    Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InputError}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding InputError}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource ErrorBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding InputError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <!-- Solution: progetti eseguibili da spuntare (uno, alcuni o tutti) -->
                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding IsSolution, Converter={StaticResource BoolToVisibility}}"
                                        IsEnabled="{Binding IsBusy, Converter={x:Static conv:InverseBooleanConverter.Instance}}">
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource LinkButton}" Content="Seleziona tutti" Command="{Binding SelectAllCommand}" />
                                        <Button Style="{StaticResource LinkButton}" Content="Nessuno" Command="{Binding SelectNoneCommand}" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <ListView Style="{StaticResource ProjectList}" ItemsSource="{Binding Projects}" SelectedItem="{Binding CurrentProject}" MaxHeight="190"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ToolTip="Spunta i progetti da compilare; clicca una riga per vederne l'analisi">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <!-- Il clic sulla casella di spunta seleziona anche la riga: l'analisi segue sempre il progetto cliccato. -->
                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnProjectRowPreviewMouseDown" />
                                            <EventSetter Event="GotKeyboardFocus" Handler="OnProjectRowGotKeyboardFocus" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="0,5" Margin="0,1">
                                                            <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView ColumnHeaderContainerStyle="{StaticResource GridHeader}">
                                            <GridViewColumn Width="34">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Progetto" Width="170">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Info.FullPath}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Target" Width="140">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding SelectedTargetFramework.DisplayName}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Stato" Width="170">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Cartella di output -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Cartella di output (Release)" />
                            </DockPanel>

                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" />
                                        <TextBlock Text="Sfoglia..." Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBox Style="{StaticResource InputBox}"
                                         Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                         ToolTip="Percorso assoluto, oppure relativo alla cartella della solution/del progetto" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,0" Text="{Binding OutputHint}" />
                            <DockPanel Margin="2,4,0,0">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{StaticResource WarningBrush}" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource WarningBrush}"
                                           Text="La cartella viene svuotata prima di ogni build." />
                            </DockPanel>

                            <!-- Opzioni .NET 5+ -->
                            <Border Background="{StaticResource SubtleBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0"
                                    IsEnabled="{Binding IsAnyNetCoreTarget}">
                                <StackPanel>
                                    <TextBlock Text="Opzioni di pubblicazione (solo .NET Core / .NET 5+)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <CheckBox Content="Self-contained (include il runtime)" IsChecked="{Binding SelfContained}" VerticalAlignment="Center" Margin="0,0,18,4" />
                                        <CheckBox Content="File singolo" IsChecked="{Binding SingleFile}" VerticalAlignment="Center" Margin="0,0,18,4" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Runtime" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}" />
                                            <ComboBox IsEditable="True" Width="110" Padding="6,4" Text="{Binding RuntimeIdentifier, UpdateSourceTrigger=LostFocus}">
                                                <ComboBox.ItemsSource>
                                                    <x:Array Type="{x:Type sys:String}">
                                                        <sys:String>win-x64</sys:String>
                                                        <sys:String>win-x86</sys:String>
                                                        <sys:String>win-arm64</sys:String>
                                                    </x:Array>
                                                </ComboBox.ItemsSource>
                                            </ComboBox>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================================== Colonna destra: analisi -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Border Style="{StaticResource StepBadge}">
                                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource CardTitle}">
                                <Run Text="Analisi" />
                                <Run Text="{Binding CurrentProject.Name, Mode=OneWay, StringFormat='— {0}'}" Foreground="{StaticResource AccentBrush}" />
                            </TextBlock>
                        </DockPanel>

                        <!-- Segnaposto senza progetto -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,30,0,30" HorizontalAlignment="Center"
                                    Visibility="{Binding HasProject, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="34" Foreground="{StaticResource BorderStrongBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Seleziona un progetto o una solution" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="per vedere framework, strumento di build e comando." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Linguaggio" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding CurrentProject.Info.Language}" />

                                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Formato" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding CurrentProject.Info.ProjectStyleDescription}" />

                                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Tipo di output" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding CurrentProject.Info.OutputKind}" />

                                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Target framework" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,3">
                                    <ComboBox ItemsSource="{Binding CurrentProject.TargetFrameworks}" SelectedItem="{Binding CurrentProject.SelectedTargetFramework}"
                                              IsEnabled="{Binding CurrentProject.IsMultiTarget}" Padding="8,5" HorizontalAlignment="Left" MinWidth="240">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Moniker, Mode=OneWay, StringFormat='  {0}'}" Foreground="{StaticResource MutedBrush}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Progetto multi-target: scegli il target da compilare."
                                               Visibility="{Binding CurrentProject.IsMultiTarget, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Strumento" VerticalAlignment="Top" Margin="0,9,16,5" />
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource Pill}" Margin="0,5">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE90F;" Margin="0,2,8,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding CurrentProject.Plan.Description}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <!-- Errori, avvisi e note -->
                            <ItemsControl ItemsSource="{Binding PlanMessages}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlanMessage}">
                                        <Border CornerRadius="6" Padding="10,7" Margin="0,0,0,6" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PlanMessageKind.Error}">
                                                            <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}" />
                                                            <Setter Property="TextElement.Foreground" Value="{StaticResource ErrorBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PlanMessageKind.Info}">
                                                            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource InfoBorderBrush}" />
                                                            <Setter Property="TextElement.Foreground" Value="{StaticResource InfoBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Margin="0,1,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                            <Setter Property="VerticalAlignment" Value="Top" />
                                                            <Setter Property="Text" Value="&#xE7BA;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PlanMessageKind.Error}">
                                                                    <Setter Property="Text" Value="&#xE783;" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PlanMessageKind.Info}">
                                                                    <Setter Property="Text" Value="&#xE946;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Comando -->
                            <TextBlock Text="COMANDO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4" />
                            <TextBox Style="{StaticResource CommandBox}"
                                     Text="{Binding CurrentProject.CommandPreview, Mode=OneWay}"
                                     ToolTip="Comando che verrà eseguito per il progetto evidenziato" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============================================================ Azioni -->
            <DockPanel Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenOutputCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" />
                            <TextBlock Text="Apri cartella output" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            ToolTip="Rileva di nuovo gli strumenti installati e rilegge i progetti">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
                            <TextBlock Text="Aggiorna" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding BuildCommand}" IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" />
                            <TextBlock Text="{Binding BuildButtonText}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" />
                            <TextBlock Text="Annulla" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            </StackPanel>
            </ScrollViewer>

            <!-- Divisore trascinabile: più spazio alla console o alla parte superiore -->
            <GridSplitter Grid.Row="1" Style="{StaticResource RowSplitter}" />

            <DockPanel Grid.Row="2">
            <!-- ============================================================ Esito della build -->
            <Border DockPanel.Dock="Top" Style="{StaticResource OutcomeBanner}"
                    Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding OpenOutputCommand}"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button.Visibility>
                            <Binding Path="Outcome" Converter="{x:Static conv:EqualsToVisibilityConverter.Instance}" ConverterParameter="Succeeded" />
                        </Button.Visibility>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" />
                            <TextBlock Text="Apri cartella" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource OutcomeIcon}" Margin="0,0,12,0">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding OutcomeTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OutcomeDetail}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Opacity="0.9"
                                   ToolTip="{Binding OutcomeDetail}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================================================ Console del log -->
            <Border Background="{StaticResource ConsoleBrush}" CornerRadius="10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource ConsoleHeaderBrush}" CornerRadius="10,10,0,0" Padding="14,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ConsoleButton}" Command="{Binding CopyLogCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" />
                                    <TextBlock Text="Copia log" Margin="6,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" FontSize="12" Foreground="{StaticResource ConsoleMutedBrush}" />
                            <TextBlock Text="Output della build" Foreground="{StaticResource ConsoleMutedBrush}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </DockPanel>
                    </Border>

                    <ListBox x:Name="LogList" ItemsSource="{Binding Log}"
                             Background="Transparent" BorderThickness="0" Padding="0,6"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             ItemContainerStyle="{StaticResource ConsoleItem}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LogLine}">
                                <TextBlock Text="{Binding Text}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LogKind.Error}">
                                                    <Setter Property="Foreground" Value="{StaticResource ConsoleErrorBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LogKind.Warning}">
                                                    <Setter Property="Foreground" Value="{StaticResource ConsoleWarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LogKind.Command}">
                                                    <Setter Property="Foreground" Value="{StaticResource ConsoleCommandBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:LogKind.Success}">
                                                    <Setter Property="Foreground" Value="{StaticResource ConsoleSuccessBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
