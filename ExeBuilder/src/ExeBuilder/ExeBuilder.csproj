<Project Sdk="Microsoft.NET.Sdk">

  <!-- Applicazione desktop WPF per .NET Framework 4.8 (formato SDK-style, Visual Studio 2019 16.3+). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ExeBuilder</AssemblyName>
    <RootNamespace>ExeBuilder</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icona del file .exe (Esplora risorse, collegamenti). Si rigenera con tools/make_icon.py. -->
    <ApplicationIcon>Assets\ExeBuilder.ico</ApplicationIcon>
    <AssemblyTitle>ExeBuilder - crea eseguibili da progetti .NET</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icona della finestra (barra del titolo, barra delle applicazioni, Alt+Tab). -->
    <Resource Include="Assets\ExeBuilder.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExeBuilder.Core\ExeBuilder.Core.csproj" />
  </ItemGroup>

</Project>
